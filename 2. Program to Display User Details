#include <stdio.h>

int main() {
    char name[50];
    int age;
    float height;

    printf("Enter name: ");
    scanf("%s", name);
    printf("Enter age: ");
    scanf("%d", &age);
    printf("Enter height: ");
    scanf("%f", &height);

    printf("\nUser Details:\n");
    printf("Name: %s\nAge: %d\nHeight: %.2f\n", name, age, height);

    return 0;
}
