#include <stdio.h>

int main() {
    int i, j, start, end, flag;

    printf("Enter range: ");
    scanf("%d %d", &start, &end);

    for(i = start; i <= end; i++) {
        flag = 1;

        if(i <= 1) continue;

        for(j = 2; j <= i/2; j++) {
            if(i % j == 0) {
                flag = 0;
                break;
            }
        }

        if(flag)
            printf("%d ", i);
    }

    return 0;
}
